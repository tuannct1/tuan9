<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".bai2.MainActivity"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStart="0dp"
        app:backgroundTint="#FF0000">
        <RelativeLayout
            android:id="@+id/tbstart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CA4242"
            android:visibility="visible"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/search_svgrepo_com"
                android:layout_alignParentEnd="true"
                />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/tbsearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CA4242"
            android:visibility="gone"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/cancel2"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:src="@drawable/cancel_svgrepo_com"
                />
            <EditText
                android:id="@+id/editSearch"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/cancel2" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_weight="1"
        android:id="@+id/rcv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />
</LinearLayout>